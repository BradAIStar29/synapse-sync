# The URL where this app is hosted
APP_URL="https://bmai-synapse-sync.pages.dev"

# Cloudflare Worker URL — the deployed API backend
# Set this after deploying the worker via wrangler
# e.g. VITE_API_URL=https://synapse-sync-api.YOUR_SUBDOMAIN.workers.dev
VITE_API_URL=

# Stripe Publishable Key (client-side, safe to expose in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Worker secrets (set via: wrangler secret put) ---
# STRIPE_SECRET_KEY — never put this in .env, set it as a wrangler secret
